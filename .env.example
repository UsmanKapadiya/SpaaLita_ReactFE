# Laravel backend (SpaaLita_backend) API root.
# php artisan serve / start-server.bat:  http://localhost:5000/api/
# XAMPP Apache:                          http://localhost/spaalita/Spaalita_backend/public/api/
VITE_API_BASE_URL=http://localhost:5000/api/

# Optional: host serving uploaded images (/uploads/...).
# Defaults to VITE_API_BASE_URL without the trailing /api.
# VITE_API_URL=http://localhost:5000

# Stripe publishable key. Must be from the same Stripe account (and mode,
# test/live) as STRIPE_SECRET_KEY in the backend .env.
VITE_STRIPE_PUBLISHABLE_KEY=
